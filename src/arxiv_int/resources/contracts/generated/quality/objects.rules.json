{
  "catalogVersion": "1.0.0",
  "contractId": "objects",
  "description": "Canonical knowledge-graph objects with lifecycle and review state.",
  "odcsId": "urn:arxiv-int:contract:objects:1.0.0",
  "primaryKey": [
    "object_id"
  ],
  "rules": [
    {
      "backend": "pandera",
      "column": "object_id",
      "dbtTest": "dbt_type",
      "description": "object_id must match logical type string.",
      "id": "objects.object_id.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "object_id",
      "dbtTest": "not_null",
      "description": "object_id is required and must not be null.",
      "id": "objects.object_id.nullability",
      "kind": "nullability",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "object_id",
      "dbtTest": "unique",
      "description": "object_id must be unique within each batch.",
      "id": "objects.object_id.batch_unique",
      "kind": "batch_unique",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "dbt",
      "column": "object_id",
      "dbtTest": "unique",
      "description": "object_id must be unique across the whole snapshot.",
      "diskBackend": "disk",
      "id": "objects.object_id.unique",
      "kind": "unique",
      "required": true,
      "scope": "snapshot",
      "severity": "error",
      "version": "1.0.0"
    },
    {
