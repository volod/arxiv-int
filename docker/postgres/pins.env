# Pinned identities for the project-owned ParadeDB + AGE image.
# Consumed by docker/postgres/Dockerfile and arxiv_int.stores.postgres_image.
#
# Research note: the design-table AGE commit 0e305662 (master, default_version
# 1.8.0) does not compile against PostgreSQL 17 because index_beginscan gained a
# different arity. The PG17 release tag below is the pinned AGE source for this
# image; master remains a future candidate when ParadeDB moves majors.

PARADEDB_IMAGE=paradedb/paradedb:0.25.6-pg17
PARADEDB_DIGEST=sha256:044b8cc5b40159714e88e3f546fc74de11cf215c030190cc82c6627015d728ea
POSTGRES_MAJOR=17
POSTGRES_VERSION=17.11
PG_SEARCH_VERSION=0.25.6
VECTOR_VERSION=0.8.4
AGE_GIT_SHA=e1467f12e0b1d15dd35d3ab93f057a7112d425b8
AGE_GIT_REF=PG17/v1.7.0-rc0
AGE_VERSION=1.7.0
IMAGE_NAME=arxiv-int/postgres
IMAGE_TAG=17-0.25.6-age1.7.0
