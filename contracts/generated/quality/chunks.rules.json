{
  "catalogVersion": "1.0.0",
  "contractId": "chunks",
  "description": "Chunker-partitioned text units derived from documents for retrieval and extraction.",
  "odcsId": "urn:arxiv-int:contract:chunks:1.0.0",
  "primaryKey": [
    "chunk_id"
  ],
  "rules": [
    {
      "backend": "pandera",
      "column": "chunk_id",
      "dbtTest": "dbt_type",
      "description": "chunk_id must match logical type string.",
      "id": "chunks.chunk_id.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "chunk_id",
      "dbtTest": "not_null",
      "description": "chunk_id is required and must not be null.",
      "id": "chunks.chunk_id.nullability",
      "kind": "nullability",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "chunk_id",
      "dbtTest": "unique",
      "description": "chunk_id must be unique within each batch.",
      "id": "chunks.chunk_id.batch_unique",
      "kind": "batch_unique",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "dbt",
      "column": "chunk_id",
      "dbtTest": "unique",
      "description": "chunk_id must be unique across the whole snapshot.",
      "diskBackend": "disk",
      "id": "chunks.chunk_id.unique",
      "kind": "unique",
      "required": true,
      "scope": "snapshot",
      "severity": "error",
      "version": "1.0.0"
    },
    {
