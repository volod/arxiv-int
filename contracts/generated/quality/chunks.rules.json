      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "dbt",
      "column": "document_id",
      "dbtTest": "relationships",
      "description": "document_id must reference corpus.documents.document_id.",
      "diskBackend": "disk",
      "id": "chunks.document_id.relationship",
      "kind": "relationship",
      "required": true,
      "scope": "snapshot",
      "severity": "error",
      "targetColumn": "document_id",
