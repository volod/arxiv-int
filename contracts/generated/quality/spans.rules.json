{
  "catalogVersion": "1.0.0",
  "contractId": "spans",
  "description": "Character-anchored spans locating evidence within documents.",
  "odcsId": "urn:arxiv-int:contract:spans:1.0.0",
  "primaryKey": [
    "span_id"
  ],
  "rules": [
    {
      "backend": "pandera",
      "column": "span_id",
      "dbtTest": "dbt_type",
      "description": "span_id must match logical type string.",
      "id": "spans.span_id.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "span_id",
      "dbtTest": "not_null",
      "description": "span_id is required and must not be null.",
      "id": "spans.span_id.nullability",
      "kind": "nullability",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "span_id",
      "dbtTest": "unique",
      "description": "span_id must be unique within each batch.",
      "id": "spans.span_id.batch_unique",
      "kind": "batch_unique",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "dbt",
      "column": "span_id",
      "dbtTest": "unique",
      "description": "span_id must be unique across the whole snapshot.",
      "diskBackend": "disk",
      "id": "spans.span_id.unique",
      "kind": "unique",
      "required": true,
      "scope": "snapshot",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "document_id",
      "dbtTest": "dbt_type",
      "description": "document_id must match logical type string.",
      "id": "spans.document_id.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "dbt",
      "column": "document_id",
      "dbtTest": "relationships",
      "description": "document_id must reference corpus.documents.document_id.",
      "diskBackend": "disk",
      "id": "spans.document_id.relationship",
      "kind": "relationship",
      "required": true,
      "scope": "snapshot",
      "severity": "error",
      "targetColumn": "document_id",
      "targetContractId": "documents",
      "targetSchema": "corpus",
      "targetTable": "documents",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "start_char",
      "dbtTest": "dbt_type",
      "description": "start_char must match logical type integer.",
      "id": "spans.start_char.type",
      "kind": "type",
      "logicalType": "integer",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "end_char",
      "dbtTest": "dbt_type",
      "description": "end_char must match logical type integer.",
      "id": "spans.end_char.type",
      "kind": "type",
      "logicalType": "integer",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "page",
      "dbtTest": "dbt_type",
      "description": "page must match logical type integer.",
      "id": "spans.page.type",
      "kind": "type",
      "logicalType": "integer",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "kind",
      "dbtTest": "dbt_type",
      "description": "kind must match logical type string.",
      "id": "spans.kind.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "generation_id",
      "dbtTest": "dbt_type",
      "description": "generation_id must match logical type string.",
      "id": "spans.generation_id.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "generation_id",
