      "id": "spans.contract_version.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    },
    {
      "backend": "pandera",
      "column": "contract_version",
      "dbtTest": "not_null",
      "description": "contract_version is required and must not be null.",
      "id": "spans.contract_version.nullability",
      "kind": "nullability",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
