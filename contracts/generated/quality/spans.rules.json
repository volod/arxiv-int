      "description": "Declared physical partition key from x-arxiv-int.partitionKey. bucket must match logical type string.",
      "id": "spans.bucket.type",
      "kind": "type",
      "logicalType": "string",
      "required": true,
      "scope": "batch",
      "severity": "error",
      "version": "1.0.0"
    }
  ],
  "schemaName": "corpus",
  "tableName": "spans",
  "version": "1.0.0"
