        "number",
        "null"
      ]
    },
    "contract_version": {
      "type": "string"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_time": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "generation_id": {
      "type": "string"
    },
    "party_object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "party_subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction_id": {
      "primaryKey": true,
