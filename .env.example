# Copy to .env for local overrides. Relative paths resolve from the project root.
# Values here are placeholders only: never commit a machine-specific absolute path.
# Roots and their storage classes are documented in docs/design/spec.md, section
# "Configuration and multi-SSD paths".

# --- Operator roots (required for corpus stages and services) ---------------------------------
# Read-only source silos. Storage class: source. Rotational disks are acceptable.
# ARCHIVE_DIR=/path/to/archive
# Additional silos use a stable uppercase id; for example:
# ARCHIVE_SILO_DRAWINGS_DIR=/path/to/drawings

# Single pipeline output root: normalized datasets, runs, proofs, exports.
# Storage class: bulk. Capacity first; a large rotational disk is acceptable.
# Must not resolve inside ARCHIVE_DIR or inside this checkout.
# RESULTS_DIR=/path/to/results

# PostgreSQL data directory: canonical tables and every lexical, vector, and graph index.
# Storage class: database. Needs a filesystem PostgreSQL supports, real per-file ownership,
# exclusive use, and an SSD/NVMe device. Do not place it on a rotational or non-native filesystem.
# PGDATA_DIR=/path/to/pgdata

# --- Derived defaults: set only when the results root is the wrong storage class ----------------
# Run journals, logs, reports, checkpoints. Default: ${RESULTS_DIR}/runs
# RUNS_DIR=

# Bounded development-loop output, kept out of published generations.
# Default: ${RESULTS_DIR}/dev
# DEV_RESULTS_DIR=

# Grafana, Prometheus, and AGE Viewer runtime state. Storage class: service-state, so it needs a
# POSIX filesystem with real ownership. Default: ${RESULTS_DIR}/services
# SERVICE_STATE_DIR=

# Model cache. Storage class: model; an SSD/NVMe removes model load latency.
# Default: ${RESULTS_DIR}/models
# MODEL_CACHE_DIR=

# Bounded extraction and sort scratch. Storage class: scratch; keep it on a fast local SSD/NVMe.
# Default: ${RESULTS_DIR}/tmp
# TMP_DIR=

# --- Optional second database device -----------------------------------------------------------
# Accepted only on a device of the same storage class as PGDATA_DIR, and backed up with it as one
# unit. Leave unset unless a second SSD/NVMe is available.
# PG_WAL_DIR=
# PG_TABLESPACE_COLD_DIR=

# --- Proof and development archives --------------------------------------------------------------
# Operator-provided read-only archive used by proof runs. Storage class: source.
# PROOF_ARCHIVE_DIR=

# Read-only archive used by the development loop. Default: ${PROOF_ARCHIVE_DIR}. Never read by
# make ci.
# DEV_ARCHIVE_DIR=

# --- Repository-local developer tooling ---------------------------------------------------------
# Linter, type-checker, and test caches only. Corpus and pipeline output never go here.
DATA_DIR=.data

# Leave unset or use auto. The shared bootstrap selects copy only across filesystems.
# UV_LINK_MODE=auto

# Application logging level.
LOG_LEVEL=INFO

# --- Local service settings --------------------------------------------------------------------
# Required by the database and passed to Compose in memory. Replace this placeholder locally.
# POSTGRES_PASSWORD=
# POSTGRES_USER=arxiv_int
# POSTGRES_DB=arxiv_int

# Host ports remain loopback-only. Uncomment only to avoid a local collision.
# POSTGRES_PORT=5432
# GRAFANA_PORT=3000
# AGE_VIEWER_PORT=3001
# PROMETHEUS_PORT=9090
# CADVISOR_PORT=8080
# VLLM_PORT=8000

# vLLM is never started by the default core profile. The default is a pinned official Qwen 27B
# FP8 release at a fixed model revision. Set tensor parallelism to the number of GPUs to use; all
# host GPUs are visible to the container. The offload default fits a 27B FP8 model on a 16 GB GPU
# when sufficient host RAM is available; reduce it on a larger GPU.
# GENERATION_MODEL=Qwen/Qwen3.8-27B-FP8
# GENERATION_MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_CPU_OFFLOAD_GB=24
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# VLLM_MAX_MODEL_LEN=32768
